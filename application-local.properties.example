# Local configuration overrides
# Copy this file to 'application-local.properties' for your machine-specific secrets/settings.
# 'application-local.properties' is git-ignored and will not be committed.

# Database credentials override
# spring.datasource.url=jdbc:mysql://localhost:3307/work_order_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# spring.datasource.username=root
# spring.datasource.password=your_secure_password_here

# JWT Secret override (must be at least 256-bit / 32 characters)
# usm.jwt.secret=your_strong_jwt_secret_key_at_least_32_bytes_long

# Sibling Service Request Service URL override
# services.service-request.base-url=http://localhost:8081
