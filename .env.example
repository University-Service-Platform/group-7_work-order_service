# ============================================================
# Spring Boot Configuration
# ============================================================

SPRING_PROFILES_ACTIVE=<PROFILE>

# ============================================================
# Database Configuration - Aiven MySQL
# ============================================================

DB_URL=jdbc:mysql://<AIVEN_HOST>:<AIVEN_PORT>/<DATABASE_NAME>?sslMode=REQUIRED
DB_USERNAME=<AIVEN_DB_USERNAME>
DB_PASSWORD=<AIVEN_DB_PASSWORD>


# ============================================================
# JWT Security
# ============================================================

JWT_SECRET=<JWT_SECRET_AT_LEAST_32_BYTES>
JWT_ISSUER=<JWT_ISSUER>
JWT_EXPIRATION_MINUTES=60


# ============================================================
# External Microservice Integrations
# ============================================================

IDENTITY_SERVICE_BASE_URL=<IDENTITY_SERVICE_BASE_URL>
GROUP6_FACILITY_SERVICE_BASE_URL=<GROUP6_FACILITY_SERVICE_BASE_URL>
GROUP6_FACILITY_ENFORCE_VALIDATION=false


# ============================================================
# Development Tools & Endpoints
# ============================================================

DEV_TOOLS_ENABLED=false
USM_DEV_TOOLS_ENABLED=false